{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Fractal Server",
            "type": "shell",
            "command": "cargo",
            "args": ["run"],
            "group": "build",
            "isBackground": true,
            "problemMatcher": ["$rustc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build Fractal Generator",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
